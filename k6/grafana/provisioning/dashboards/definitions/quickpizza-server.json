{
  "uid": "quickpizza-server",
  "title": "QuickPizza - Servidor",
  "tags": [
    "k6",
    "quickpizza"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Carga aplicada (k6) vs CPU del servidor",
      "description": "La correlacion clave: ¿a cuantos VUs se satura la CPU? Con limite de 0.5 cores el techo es 50%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_vus)",
          "legendFormat": "VUs k6"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"quickpizza\"}[30s])*100",
          "legendFormat": "CPU servidor (% de 1 core)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests/s por endpoint (visto por el servidor)",
      "description": "Incluye llamadas internas: una recomendacion genera varias requests internas (catalogo, nombres).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (path) (rate(quickpizza_server_http_requests_total{path!=\"/metrics\"}[30s]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia p95 en el servidor por endpoint",
      "description": "Comparar con p95 de k6: la diferencia es tiempo de red + cola fuera de la app.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(quickpizza_server_http_request_duration_seconds_bucket{path!=\"/metrics\"}[30s])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errores 5xx/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (path, status) (rate(quickpizza_server_http_requests_total{status=~\"5..\",path!=\"/metrics\"}[30s]))",
          "legendFormat": "{{path}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Goroutines (trabajo concurrente en curso)",
      "description": "Si crece sin bajar: las requests se estan encolando.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_goroutines{job=\"quickpizza\"}",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memoria residente",
      "description": "Limite del contenedor: 256 MB.",
